# Evaluation-only single-service Render image. Not a durable production deployment.
FROM node:22-bookworm-slim AS frontend
WORKDIR /frontend
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 NODE_ENV=production PORT=10000 VIDEOFX_HEADLESS=true VIDEOFX_CHROMIUM_PATH=/usr/bin/chromium
RUN apt-get update && apt-get install -y --no-install-recommends nginx ffmpeg chromium libgl1 libglib2.0-0 git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY requirements.lock .
RUN pip install --no-cache-dir -r requirements.lock
COPY . .
COPY --from=frontend /frontend/.next/standalone /app/frontend
COPY --from=frontend /frontend/.next/static /app/frontend/.next/static
COPY --from=frontend /frontend/public /app/frontend/public
COPY deploy/render/nginx.conf /etc/nginx/nginx.conf
COPY deploy/render/start.sh /app/deploy/render/start.sh
RUN chmod +x /app/deploy/render/start.sh && mkdir -p data workspace outputs agent_workspace assets videofx_outputs /tmp/nginx /var/log/nginx && chmod -R 777 data workspace outputs agent_workspace assets videofx_outputs /tmp/nginx
EXPOSE 10000
CMD ["/app/deploy/render/start.sh"]
